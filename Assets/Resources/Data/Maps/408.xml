						<pet id="138" level="70">
							<loopSkill>10050</loopSkill>
						</pet>
					</enemy>
					<winHandler>
						<button type="auto">
							<action>setItem</action>
							<param>add</param>
							<param>22035,1</param>
							<condition>random[old]&lt;10</condition>
						</button>
						<button type="auto">
							<action>openHintbox</action>
							<param>type=Item</param>
							<param>title=提示</param>
							<param>content=1个雪球已经放入背包</param>
							<param>item_icon=buff[420035]</param>
							<param>option_num=1</param>
							<condition>random[old]&lt;10</condition>
						</button>
					</winHandler>
