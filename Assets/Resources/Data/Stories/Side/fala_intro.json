        {
          "type": "show",
          "actor": "bulutuo"
        },
        {
          "type": "narrate",
          "text": "\u5f02\u8611\u4e16\u754c\u7684\u5149\u4ece\u5de8\u5927\u8611\u83c7\u4f1e\u4e4b\u95f4\u6f0f\u4e0b\u6765\uff0c\u50cf\u4e00\u76cf\u88ab\u7ba1\u7406\u5458\u8c03\u6210\u67d4\u5149\u6a21\u5f0f\u7684\u661f\u9645\u63a2\u7167\u706f\u3002\u516d\u540d\u4e34\u65f6\u961f\u5458\u7ad9\u5728\u9053\u8def\u4e24\u4fa7\uff0c\u6c14\u6c1b\u5e84\u91cd\u5f97\u50cf\u8981\u5f00\u8239\uff0c\u5b9e\u9645\u9884\u7b97\u53ea\u591f\u5f00\u4f1a\u3002"
        },
        {
          "type": "say",
          "actor": "fala",
          "text": "\u5404\u4f4d\uff0c\u6b22\u8fce\u53c2\u52a0\u963f\u5361\u8fea\u4e9a\u661f\u9645\u5de1\u67e5\u6f14\u793a\u3002\u9996\u5148\u58f0\u660e\uff1a\u672c\u6d3b\u52a8\u4e0d\u63d0\u4f9b\u71c3\u6599\u3001\u4e0d\u63d0\u4f9b\u53d1\u5c04\u53f0\uff0c\u4e5f\u4e0d\u63d0\u4f9b\u4e8b\u540e\u5199\u62a5\u544a\u7684\u5fc3\u7406\u54a8\u8be2\u3002"
        },
        {
          "type": "say",
          "actor": "buer",
          "text": "\u6211\u53ea\u542c\u89c1\u4e86\u4e0d\u63d0\u4f9b\u3002\u90a3\u6211\u4eec\u5230\u5e95\u63d0\u4f9b\u4ec0\u4e48\uff1f"
        },
        {
          "type": "say",
          "actor": "fala",
          "text": "\u63d0\u4f9b\u60f3\u8c61\u529b\u3002\u4ee5\u53ca\u4e00\u5757\u5199\u7740\u201c\u5df2\u68c0\u67e5\u201d\u7684\u8611\u83c7\u5f62\u8bb0\u5f55\u677f\u3002\u5b83\u6628\u5929\u8fd8\u662f\u9910\u76d8\uff0c\u4eca\u5929\u88ab\u63d0\u62d4\u4e86\u3002"
        },
        {
          "type": "choice",
          "choices": [
            {
              "text": "\u8ba4\u771f\u8be2\u95ee\u5de1\u67e5\u76ee\u6807\u3002",
              "target": "ask_goal"
            },
            {
              "text": "\u5148\u8d28\u7591\u8fd9\u8258\u201c\u98de\u8239\u201d\u7684\u5408\u6cd5\u6027\u3002",
              "target": "ask_ship"
            }
          ]
        }
      ]
    },
    {
      "id": "ask_goal",
      "commands": [
        {
          "type": "say",
          "actor": "fanna",
          "text": "\u5de1\u67e5\u76ee\u6807\u662f\u89c2\u5bdf\u4e16\u754c\u53d8\u5316\u3002\u6700\u597d\u8fdc\u8fdc\u5730\u89c2\u5bdf\u3002\u8d8a\u8fdc\u8d8a\u5b89\u5168\uff0c\u8d8a\u5b89\u5168\u8d8a\u50cf\u6211\u5728\u8ba4\u771f\u5de5\u4f5c\u3002"
        },
        {
          "type": "say",
          "actor": "xiaoxiaokui",
          "text": "\u6211\u4e5f\u64c5\u957f\u548c\u81ea\u7136\u878d\u5408\u3002\u53ea\u8981\u5927\u5bb6\u4e0d\u8e29\u5230\u6211\uff0c\u6211\u53ef\u4ee5\u878d\u5408\u5f97\u975e\u5e38\u5f7b\u5e95\u3002"
        },
        {
          "type": "choice",
          "choices": [
            {
              "text": "\u8be2\u95ee\u5c0f\u5c0f\u8475\u7684\u81ea\u7136\u878d\u5165\u65b9\u6848\u3002",
              "target": "nature_blend"
            },
            {
              "text": "\u8be2\u95ee\u53f3\u4fa7\u5410\u69fd\u7ec4\u7684\u9884\u7b97\u8d21\u732e\u3002",
              "target": "budget_contribution"
            }
          ]
        },
        {
          "type": "jump",
          "target": "briefing"
        }
      ]
    },
    {
      "id": "nature_blend",
      "commands": [
        {
          "type": "say",
          "actor": "xiaoxiaokui",
          "text": "\u65b9\u6848\u5f88\u7b80\u5355\uff1a\u5927\u5bb6\u4fdd\u6301\u5b89\u9759\uff0c\u6211\u8d1f\u8d23\u770b\u8d77\u6765\u50cf\u4e00\u7247\u975e\u5e38\u6709\u4e8b\u4e1a\u5fc3\u7684\u53f6\u5b50\u3002\u5982\u679c\u654c\u4eba\u53d1\u73b0\u4e86\u6211\uff0c\u5c31\u8bf4\u660e\u4ed6\u4eec\u5ba1\u7f8e\u4e0d\u9519\u3002"
        },
        {
          "type": "jump",
          "target": "briefing"
        }
      ]
    },
    {
      "id": "budget_contribution",
      "commands": [
        {
          "type": "say",
          "actor": "buer",
          "text": "\u9884\u7b97\u8d21\u732e\uff1f\u6211\u53ef\u4ee5\u8d21\u732e\u4e00\u4e2a\u5750\u57ab\u7ea7\u5b89\u5168\u7f13\u51b2\u548c\u4e09\u53e5\u9f13\u821e\u58eb\u6c14\u7684\u8bdd\u3002\u7b2c\u56db\u53e5\u8981\u52a0\u73ed\u8d39\u3002"
        },
        {
          "type": "jump",
          "target": "briefing"
        }
      ]
    },
    {
      "id": "ask_ship",
      "commands": [
        {
          "type": "say",
          "actor": "bulutuo",
          "text": "\u5408\u6cd5\u6027\uff1f\u6211\u5750\u8fc7\u6bd4\u8fd9\u66f4\u53ef\u7591\u7684\u4ea4\u901a\u5de5\u5177\u3002\u6bd4\u5982\u5c0f\u6811\u6839\u3002\u867d\u7136\u5b83\u672c\u4eba\u4e00\u76f4\u8868\u793a\u90a3\u4e0d\u662f\u4ea4\u901a\u5de5\u5177\u3002"
        },
        {
          "type": "say",
          "actor": "fala",
          "text": "\u672c\u8239\u540d\u53eb\u8611\u83c7\u53f7\uff0c\u8239\u4f53\u7531\u8def\u7ebf\u56fe\u3001\u5de1\u67e5\u8868\u548c\u5927\u5bb6\u7684\u914d\u5408\u7ec4\u6210\u3002\u914d\u5408\u4e00\u6563\uff0c\u8239\u5c31\u5730\u89e3\u4f53\uff0c\u4fd7\u79f0\u6563\u4f1a\u3002"
        },
        {
          "type": "jump",
          "target": "briefing"
        }
      ]
    },
    {
      "id": "briefing",
      "commands": [
        {
          "type": "narrate",
          "text": "\u6cd5\u62c9\u5c55\u5f00\u8bb0\u5f55\u677f\uff0c\u80cc\u9762\u8d34\u7740\u4e00\u5f20\u624b\u7ed8\u661f\u56fe\u3002\u661f\u56fe\u53f3\u4e0b\u89d2\u5199\u7740\uff1a\u5982\u8ff7\u8def\uff0c\u8bf7\u5148\u4e0d\u8981\u8d23\u602a\u661f\u661f\u3002\u661f\u661f\u6ca1\u6709\u5ba2\u670d\u3002"
        },
        {
          "type": "say",
          "actor": "fayina",
          "text": "\u661f\u7a7a\u91cc\u6709\u529b\u91cf\u3002\u4e5f\u6709\u6c89\u9ed8\u3002\u8fd8\u6709\u4e00\u9897\u661f\u521a\u521a\u7728\u4e86\u4e09\u4e0b\uff0c\u53ef\u80fd\u662f\u5728\u63d0\u9192\u6211\u4eec\u628a\u8868\u683c\u5199\u5168\u3002"
        },
        {
          "type": "say",
          "actor": "buer",
          "text": "\u6211\u53ef\u4ee5\u8d1f\u8d23\u5b89\u5168\u3002\u6211\u7684\u8102\u80aa\u662f\u6709\u5229\u7684\u653b\u51fb\u6b66\u5668\uff0c\u4e5f\u662f\u7d27\u6025\u7f13\u51b2\u57ab\u3002\u7f3a\u70b9\u662f\u522b\u4eba\u4f1a\u4ee5\u4e3a\u6211\u5728\u5077\u61d2\u3002"
        },
        {
          "type": "say",
          "actor": "fala",
          "text": "\u5f88\u597d\u3002\u5de6\u4fa7\u662f\u963f\u5361\u8fea\u4e9a\u89c2\u5bdf\u7ec4\uff0c\u53f3\u4fa7\u662f\u5916\u52e4\u5410\u69fd\u7ec4\u3002\u8bf7\u5927\u5bb6\u4fdd\u6301\u961f\u5f62\uff0c\u4e0d\u8981\u628a\u8fd9\u4ef6\u4e8b\u53d8\u6210\u8de8\u5730\u56fe\u804a\u5929\u9891\u9053\u3002"
        },
        {
          "type": "choice",
          "choices": [
            {
              "text": "\u68c0\u67e5\u661f\u9645\u8def\u7ebf\u3002",
              "target": "route_check"
            },
            {
              "text": "\u68c0\u67e5\u4e34\u65f6\u8865\u7ed9\u3002",
              "target": "supply_check"
            }
          ]
        }
      ]
    },
    {
      "id": "route_check",
      "commands": [
        {
          "type": "say",
          "actor": "fala",
          "text": "\u8def\u7ebf\u662f\u8fd9\u6837\u7684\uff1a\u4ece\u5f02\u8611\u4e16\u754c\u51fa\u53d1\uff0c\u7ed5\u5f00\u201c\u661f\u661f\u5728\u7728\u773c\u5f02\u5e38\u9891\u7e41\u533a\u201d\uff0c\u7a7f\u8fc7\u201c\u884c\u653f\u5ba1\u6279\u9668\u77f3\u5e26\u201d\uff0c\u6700\u540e\u62b5\u8fbe\u636e\u8bf4\u5f88\u50cf\u76ee\u7684\u5730\u7684\u5730\u65b9\u3002"
        },
        {
          "type": "say",
          "actor": "xiaoxiaokui",
          "text": "\u636e\u8bf4\u5f88\u50cf\u76ee\u7684\u5730\uff0c\u8fd9\u53e5\u8bdd\u542c\u8d77\u6765\u975e\u5e38\u5192\u9669\uff0c\u4e5f\u975e\u5e38\u4e0d\u60f3\u8d1f\u8d23\u3002"
        },
        {
          "type": "jump",
          "target": "signal"
        }
      ]
    },
    {
      "id": "supply_check",
      "commands": [
        {
          "type": "say",
          "actor": "fanna",
          "text": "\u8865\u7ed9\u6e05\u5355\uff1a\u51c9\u8611\u83c7\u4e24\u6735\uff0c\u5907\u7528\u4efb\u52a1\u65e5\u5fd7\u5341\u4e03\u672c\uff0c\u4e00\u5757\u5199\u7740\u201c\u4e0d\u8981\u614c\u201d\u7684\u724c\u5b50\u3002\u80cc\u9762\u5199\u7740\u201c\u5982\u679c\u5df2\u7ecf\u614c\u4e86\uff0c\u8bf7\u5047\u88c5\u6ca1\u6709\u201d\u3002"
        },
        {
          "type": "say",
          "actor": "bulutuo",
          "text": "\u6211\u5efa\u8bae\u518d\u52a0\u4e00\u9879\uff1a\u5982\u679c\u98de\u8239\u4e0d\u80fd\u8d77\u98de\uff0c\u5c31\u5ba3\u5e03\u8fd9\u662f\u4e00\u6b21\u5730\u9762\u6c89\u6d78\u5f0f\u8bad\u7ec3\u3002\u542c\u8d77\u6765\u7acb\u523b\u4e13\u4e1a\u5f88\u591a\u3002"
        },
        {
          "type": "jump",
          "target": "signal"
        }
      ]
    },
    {
      "id": "signal",
      "commands": [
        {
          "type": "say",
          "actor": "fayina",
          "text": "\u661f\u661f\u56de\u5e94\u4e86\u3002\u5b83\u8bf4\uff1a\u8bf7\u786e\u8ba4\u4e58\u5458\u662f\u5426\u771f\u7684\u77e5\u9053\u81ea\u5df1\u5728\u505a\u4ec0\u4e48\u3002"
        },
        {
          "type": "say",
          "actor": "fala",
          "text": "\u4e0d\u7528\u592a\u6b63\u5f0f\u3002\u661f\u9645\u5192\u9669\u7ecf\u8d39\u6709\u9650\uff0c\u5f69\u8679\u5c41\u4e5f\u53ef\u4ee5\u8d70\u7b80\u6613\u62a5\u9500\u3002\u73b0\u5728\uff0c\u9009\u62e9\u901a\u4fe1\u65b9\u5f0f\u3002"
        },
        {
          "type": "choice",
          "choices": [
            {
              "text": "\u7528\u661f\u661f\u7728\u773c\u53d1\u4fe1\u53f7\u3002",
              "target": "blink_signal"
            },
            {
              "text": "\u7528\u8611\u83c7\u9891\u9053\u53d1\u4fe1\u53f7\u3002",
              "target": "mushroom_channel"
            }
          ]
        }
      ]
    },
    {
      "id": "blink_signal",
      "commands": [
        {
          "type": "say",
          "actor": "fayina",
          "text": "\u4e09\u77ed\u4e00\u957f\u8868\u793a\u4f60\u597d\uff0c\u4e00\u957f\u4e09\u77ed\u8868\u793a\u4f60\u7ad9\u9519\u822a\u9053\u3002\u5982\u679c\u4e00\u76f4\u4eae\u7740\uff0c\u90a3\u5c31\u662f\u661f\u661f\u4e5f\u4e0d\u77e5\u9053\u8be5\u600e\u4e48\u529e\u3002"
        },
        {
          "type": "jump",
          "target": "ending"
        }
      ]
    },
    {
      "id": "mushroom_channel",
      "commands": [
        {
          "type": "say",
          "actor": "xiaoxiaokui",
          "text": "\u8611\u83c7\u9891\u9053\u7a33\u5b9a\uff0c\u7f3a\u70b9\u662f\u5ef6\u8fdf\u9ad8\u3002\u6bd5\u7adf\u5b62\u5b50\u6ca1\u6709\u52a0\u73ed\u8d39\uff0c\u4f20\u6d88\u606f\u5168\u9760\u81ea\u89c9\u3002"
        },
        {
          "type": "jump",
          "target": "ending"
        }
      ]
    },
    {
      "id": "ending",
      "commands": [
        {
          "type": "narrate",
          "text": "\u4e34\u65f6\u5de1\u67e5\u961f\u5b8c\u6210\u4e86\u5168\u90e8\u6d41\u7a0b\u3002\u661f\u661f\u7728\u4e86\u4e00\u4e0b\uff0c\u8611\u83c7\u8f7b\u8f7b\u6643\u52a8\uff0c\u8bb0\u5f55\u677f\u4e0a\u201c\u5df2\u68c0\u67e5\u201d\u4e09\u4e2a\u5b57\u663e\u5f97\u683c\u5916\u53ef\u9760\uff0c\u867d\u7136\u5b83\u8fd8\u662f\u5f88\u50cf\u9910\u76d8\u3002"
        },
        {
          "type": "say",
          "actor": "fala",
          "text": "\u6f14\u793a\u7ed3\u8bba\uff1a\u4f60\u9002\u5408\u592a\u7a7a\u5192\u9669\u3002\u4f18\u70b9\u662f\u613f\u610f\u542c\u6307\u6325\uff0c\u7f3a\u70b9\u662f\u592a\u613f\u610f\u542c\u6211\u8bb2\u5b89\u5168\u987b\u77e5\u3002\u6b63\u5e38\u4eba\u542c\u5230\u884c\u653f\u5ba1\u6279\u9668\u77f3\u5e26\u65f6\u5c31\u8be5\u540e\u9000\u4e86\u3002"
        },
        {
          "type": "say",
          "actor": "bulutuo",
