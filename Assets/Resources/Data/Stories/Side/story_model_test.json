        { "type": "choice", "choiceId": "route_choice", "actor": "fala", "text": "【测试 2】法拉（左侧）提问：问题与选项应同时出现，选项应在右侧。请选择路线。", "choices": [
          { "optionId": "route_a", "text": "选择 A：走左侧路线" },
