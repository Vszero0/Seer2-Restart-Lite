        { "type": "jump", "target": "second_choice" }
      ]
    },
    {
      "id": "route_b",
      "displayName": "分支 B：记录第一次选择",
      "commands": [
        { "type": "say", "actor": "fanna", "text": "【测试 2/第一次选择】已进入分支 B，说明第一次选择记录为 route_b。现在进入第二次选择。" },
        { "type": "jump", "target": "second_choice" }
      ]
    },
    {
      "id": "second_choice",
      "displayName": "第二次选择与多条件判断",
      "scenes": [
        {
          "id": "test_scene",
          "mapId": 122,
          "bgmResourcePath": "BGM/101/BGM_1.mp3",
          "actorIds": [ "fayina" ],
          "layout": {
            "actorSpacing": 180,
            "actorHeight": 260,
            "actorBottom": 150,
            "centerGap": 135,
            "stackOffset": 20
          }
        }
      ],
      "commands": [
        { "type": "scene", "sceneId": "test_scene" },
        { "type": "show", "actor": "fayina" },
        { "type": "narrate", "text": "【测试 3/场景切换】已切换到 test_scene：背景应变为地图 122。此场景显式覆盖 BGM 为 BGM_1；原场景角色应被清空并加载法伊娜。" },
        { "type": "choice", "choiceId": "layout_choice", "actor": "fayina", "text": "【测试 4】法伊娜（右侧）提问：问题与选项应同时出现，选项应在左侧。请选择布局方案。", "choices": [
          { "optionId": "layout_left", "text": "选择左侧布局方案" },
          { "optionId": "layout_right", "text": "选择右侧布局方案" }
        ] },
        { "type": "jump", "target": "sequence_pass", "condition": { "operatorType": "AND", "conditions": [ { "type": "ChoiceSequenceMatched", "optionSequence": [ "route_a", "layout_left" ] } ] } },
        { "type": "jump", "target": "and_pass", "condition": { "operatorType": "AND", "conditions": [ { "type": "ChoiceSelected", "choiceId": "route_choice", "optionId": "route_a" }, { "type": "ChoiceSelected", "choiceId": "layout_choice", "optionId": "layout_left" } ] } },
        { "type": "jump", "target": "or_pass", "condition": { "operatorType": "OR", "conditions": [ { "type": "ChoiceSelected", "choiceId": "route_choice", "optionId": "route_a" }, { "type": "ChoiceSelected", "choiceId": "layout_choice", "optionId": "layout_right" } ] } },
        { "type": "jump", "target": "condition_default" }
      ]
    },
    {
      "id": "sequence_pass",
      "displayName": "序列条件命中",
      "commands": [
        { "type": "say", "actor": "fayina", "text": "【测试 4/ChoiceSequenceMatched】已命中序列 [route_a, layout_left]。这次同时验证了：第一次选择 A、第二次选择左侧，以及连续选择顺序判断。" },
        { "type": "jump", "target": "and_probe" }
      ]
    },
    {
      "id": "and_probe",
      "displayName": "独立 AND 条件检查",
      "commands": [
        { "type": "jump", "target": "and_pass", "condition": { "operatorType": "AND", "conditions": [ { "type": "ChoiceSelected", "choiceId": "route_choice", "optionId": "route_a" }, { "type": "ChoiceSelected", "choiceId": "layout_choice", "optionId": "layout_left" } ] } },
        { "type": "jump", "target": "condition_default" }
      ]
    },
    {
      "id": "and_pass",
      "displayName": "AND 条件命中",
      "commands": [
        { "type": "say", "actor": "fayina", "text": "【测试 4/AND】已命中 AND：第一次选择是 A，并且第二次选择是左侧布局。" },
        { "type": "jump", "target": "visibility_test" }
      ]
    },
    {
      "id": "or_pass",
      "displayName": "OR 条件命中",
      "commands": [
        { "type": "say", "actor": "fayina", "text": "【测试 4/OR】已命中 OR：至少一个选择条件成立。你可以重进本支线，尝试其他组合。" },
        { "type": "jump", "target": "visibility_test" }
      ]
    },
    {
      "id": "condition_default",
      "displayName": "条件未命中",
      "commands": [
        { "type": "narrate", "text": "【测试 4/条件未命中】当前选择组合没有命中预设的序列、AND 或 OR 条件。请记录前两次选项后再判断是否符合预期。" },
        { "type": "jump", "target": "visibility_test" }
      ]
    },
    {
      "id": "visibility_test",
      "displayName": "show/hide 与最终状态",
      "commands": [
        { "type": "hide", "actor": "fayina" },
        { "type": "show", "actor": "fala" },
        { "type": "narrate", "text": "【测试 5/show-hide】法伊娜已 hide，法拉已重新 show。请观察角色显示状态、左右位置、缩放和朝向是否符合资源定义。" },
        { "type": "say", "actor": "fala", "text": "【测试完成】本次支线已覆盖：资源定义、角色引用、场景切换、BGM、layout、show/hide、两次选择、AND、OR、选择序列和可重复进入。请退出后再次进入，重复验证。" },
        { "type": "end" }
      ]
    }
