        { "type": "jump", "target": "route_a", "condition": { "operatorType": "AND", "conditions": [ { "type": "ChoiceSelected", "choiceId": "route_choice", "optionId": "route_a" } ] } },
        { "type": "jump", "target": "route_b", "condition": { "operatorType": "AND", "conditions": [ { "type": "ChoiceSelected", "choiceId": "route_choice", "optionId": "route_b" } ] } }
      ]
    },
    {
      "id": "route_a",
      "displayName": "分支 A：记录第一次选择",
